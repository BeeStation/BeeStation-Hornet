/datum/unit_test/brandish_rectangular_geometry/Run()
	var/obj/structure/shipping_container/box = allocate(/obj/structure/shipping_container, run_loc_floor_bottom_left)
	var/datum/world_space_icon/geometry/projection = box.world_space_icon
	TEST_ASSERT_EQUAL(box.bound_width, 96, "Rendering must retain the physical footprint")
	TEST_ASSERT_EQUAL(box.pixel_x, 0, "Rendering must retain map offsets")
	TEST_ASSERT_EQUAL(box.pixel_w, 0, "Geometry does not migrate map offsets into screen axes")
	TEST_ASSERT_EQUAL(box.get_cached_width(), 96, "Metadata consumers must not see the blank carrier's 32px width")
	TEST_ASSERT_EQUAL(box.get_cached_height(), 64, "Metadata consumers retain the original rectangular height")
	if(!GLOB.brandish_assets.supports(initial(box.icon), BRANDISH_ASSET_VIEW_GATES))
		TEST_ASSERT(!projection?.projected, "Fallback does not project absent resources")
		TEST_ASSERT_EQUAL(box.icon, initial(box.icon), "Fallback retains the original container artwork")
		TEST_ASSERT_EQUAL(length(box.overlays), 0, "Fallback does not attach sparse views")
		return
	TEST_ASSERT(projection?.projected, "Multi-tile containers use ordinary projected overlays")
	TEST_ASSERT(!projection.refresh(), "Unchanged geometry does not rewrite overlays")
	box.bound_width += ICON_SIZE_X
	TEST_ASSERT(projection.refresh(), "Changed gameplay bounds invalidate the projection")
	box.bound_width -= ICON_SIZE_X
	TEST_ASSERT(projection.refresh(), "Restoring bounds rebuilds the original projection")
	TEST_ASSERT(!projection.refresh(), "The restored projection is cached")
	box.cut_overlays()
	TEST_ASSERT(projection.refresh(), "Clearing overlays invalidates the cached presentation")
	TEST_ASSERT_EQUAL(length(box.overlays), 4, "A refresh restores the cleared sparse views")
	var/obj/effect/replacement = allocate(/obj/effect)
	box.copy_overlays(replacement, TRUE)
	TEST_ASSERT(projection.refresh(), "Replacing overlays invalidates the cached presentation")
	TEST_ASSERT_EQUAL(length(box.overlays), 4, "Replacement cannot leave a blank projected carrier")
	var/list/expected = list("1" = list(0,0), "2" = list(0,-32), "4" = list(-48,16), "8" = list(-16,16))
	for(var/repeat in 1 to 3)
		APPLY_BRANDISH_ICON(box)
		var/index = 0
		for(var/facing in GLOB.cardinals)
			var/image/drawing = projection.layers[++index]
			var/list/offset = expected["[facing]"]
			TEST_ASSERT_EQUAL(drawing.transform.c, offset[1], "Canvas/bounds X correction must not accumulate")
			TEST_ASSERT_EQUAL(drawing.transform.f, offset[2], "Canvas/bounds Y correction must not accumulate")
	var/obj/effect/copy = allocate(/obj/effect)
	copy.appearance = box.appearance
	TEST_ASSERT_EQUAL(length(copy.overlays), 4, "Appearance copies retain all four sparse views")

/datum/unit_test/brandish_geometry_overlay/Run()
	var/obj/machinery/power/bsa/full/cannon = allocate(/obj/machinery/power/bsa/full, run_loc_floor_bottom_left)
	STOP_PROCESSING(SSmachines, cannon)
	cannon.cell.charge = cannon.cell.maxcharge
	var/list/icon_offsets = cannon.get_oversized_icon_offsets()
	TEST_ASSERT_EQUAL(icon_offsets["x"], 161.5, "Progress-bar metadata retains the original odd canvas width")
	TEST_ASSERT_EQUAL(icon_offsets["y"], 22, "Progress-bar metadata retains the original canvas height")
	for(var/facing in list(WEST,EAST))
		cannon.setDir(facing)
		cannon.update_icon()
		var/part_count = length(cannon.overlays)
		cannon.update_icon()
		var/generated = GLOB.brandish_assets.supports(initial(cannon.icon), BRANDISH_ASSET_VIEW_GATES)
		TEST_ASSERT_EQUAL(length(cannon.overlays), part_count, "Repeated charged updates do not accumulate drawings")
		var/list/rendered_states = list()
		for(var/image/part as anything in cannon.overlays)
			var/state = part.icon_state
			var/view_suffix = findtext(state, "@")
			if(view_suffix)
				state = copytext(state, 1, view_suffix)
			rendered_states[state] = TRUE
		TEST_ASSERT(rendered_states["top_[dir2text(facing)]"], "The visible top is retained")
		for(var/charge in list(25, 50, 75, 100))
			TEST_ASSERT(rendered_states["bsa_[dir2text(facing)]_capacitor_[charge]"], "Charged artwork [charge] is retained")
		if(generated)
			TEST_ASSERT(cannon.world_space_icon?.projected, "The cannon body retains its projected view")
		var/image/top = cannon.brandish_geometry_overlay("top_[dir2text(facing)]", ABOVE_MOB_LAYER)
		TEST_ASSERT_EQUAL(top.layer, ABOVE_MOB_LAYER, "A projected top retains its draw layer")
		if(!generated)
			TEST_ASSERT_EQUAL(cannon.icon, initial(cannon.icon), "Fallback retains original cannon artwork")
			TEST_ASSERT_EQUAL(top.icon, initial(cannon.icon), "Fallback top retains its original resource")
			TEST_ASSERT_EQUAL(top.icon_state, "top_[dir2text(facing)]", "Fallback keeps the physical top state")
			TEST_ASSERT_EQUAL(length(top.overlays), 0, "Fallback top has no sparse children")
			continue
		TEST_ASSERT_EQUAL(length(top.overlays), 4, "A projected top is an ordinary nested appearance")
		for(var/image/drawing as anything in top.overlays)
			TEST_ASSERT_EQUAL(drawing.icon_state, "top_[dir2text(facing)]@2", "Each instance keeps its own physical top state")

