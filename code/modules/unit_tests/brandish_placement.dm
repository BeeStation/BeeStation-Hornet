	TEST_ASSERT_EQUAL(result.pixel_z, 8, "Cooking preserves the screen Y placement")
	result.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT_EQUAL(result.pixel_x, 7, "Removing cooked food preserves its original X placement")
	TEST_ASSERT_EQUAL(result.pixel_y, 8, "Removing cooked food preserves its original Y placement")
	TEST_ASSERT_EQUAL(length(griddle.griddled_objects), 0, "Completed and removed food leaves no grill callbacks behind")

