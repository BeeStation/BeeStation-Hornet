/datum/unit_test/brandish_copied_appearance_origin/Run()
	for(var/resource in list('icons/effects/64x64.dmi', 'icons/effects/96x96.dmi'))
		var/obj/source = allocate(/obj)
		source.icon = resource
		var/width = source.get_cached_width()
		var/origin = -(width - ICON_SIZE_X) / 2
		source.pixel_x = 5
		source.pixel_y = 7
		source.pixel_w = origin
		source.pixel_z = origin
		var/mutable_appearance/copy = copy_appearance_without_offsets(source)
		TEST_ASSERT(copy.pixel_x == 0 && copy.pixel_y == 0 && copy.pixel_w == 0 && copy.pixel_z == 0, "Local copies clear map and screen placement")
		TEST_ASSERT_EQUAL(source.pixel_x, 5, "Copying must not mutate live world placement")
		TEST_ASSERT_EQUAL(source.pixel_w, origin, "Copying must not mutate the live screen origin")
		var/mutable_appearance/small = get_small_overlay(source)
		TEST_ASSERT_EQUAL(small.pixel_x, origin, "The preview adds its own canvas origin once")
		TEST_ASSERT_EQUAL(small.pixel_w, 0, "The source screen origin is absent from the preview")
		TEST_ASSERT_EQUAL(small.pixel_z, 0, "The source height is absent from the preview")
	var/obj/item/borg/apparatus/circuit/holder = allocate(/obj/item/borg/apparatus/circuit)
	var/obj/item/electronics/airlock/part = allocate(/obj/item/electronics/airlock)
	part.pixel_x = 5
	part.pixel_y = 7
	part.pixel_w = -16
	part.pixel_z = -16
	holder.stored = part
	var/list/parts = holder.update_overlays()
	var/mutable_appearance/drawing
	for(var/mutable_appearance/candidate as anything in parts)
		if(candidate.icon == part.icon && candidate.icon_state == part.icon_state)
			drawing = candidate
			break
	TEST_ASSERT(drawing, "The circuit holder includes the stored part's artwork")
	TEST_ASSERT_EQUAL(drawing.pixel_x, -3, "The circuit holder owns its local placement")
	TEST_ASSERT(drawing.pixel_y == 0 && drawing.pixel_w == 0 && drawing.pixel_z == 0, "The held preview excludes the live origin")
	TEST_ASSERT(part.pixel_x == 5 && part.pixel_y == 7 && part.pixel_w == -16 && part.pixel_z == -16, "Building a held preview does not move the live item")
