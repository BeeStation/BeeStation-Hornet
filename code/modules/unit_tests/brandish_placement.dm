/datum/unit_test/brandish_click_placement/Run()
	var/list/modifiers = list(ICON_X = "23", ICON_Y = "24")
	for(var/facing in GLOB.cardinals)
		var/list/offset = camera_click_offset(modifiers, facing)
		var/list/screen = camera_world_to_screen(offset[1], offset[2], facing)
		TEST_ASSERT_EQUAL(screen[1], 7, "Click placement preserves screen X at [facing]")
		TEST_ASSERT_EQUAL(screen[2], 8, "Click placement preserves screen Y at [facing]")
	var/list/north = camera_click_offset(modifiers)
	TEST_ASSERT_EQUAL(north[1], 7, "Default placement preserves the original X")
	TEST_ASSERT_EQUAL(north[2], 8, "Default placement preserves the original Y")
	TEST_ASSERT_NULL(camera_click_offset(list(ICON_X = "23")), "An incomplete click has no placement offset")
	var/list/corner = camera_click_offset(list(ICON_X = "0", ICON_Y = "0"), EAST)
	TEST_ASSERT_EQUAL(corner[1], -16, "Zero-valued icon coordinates are valid")
	TEST_ASSERT_EQUAL(corner[2], 16, "The bottom-left corner projects into world axes")

/datum/unit_test/brandish_hud_angles/Run()
	for(var/facing in GLOB.cardinals)
		var/angle = camera_world_angle_to_screen(37, facing)
		TEST_ASSERT_EQUAL(angle + dir2angle(facing), 37, "HUD bearing restores world angle at [facing]")
	TEST_ASSERT_EQUAL(camera_world_angle_to_screen(37), 37, "Default HUD bearing is unchanged")
	TEST_ASSERT_EQUAL(camera_world_angle_to_screen(0, EAST), -90, "World north points left for an east-facing viewer")

/mob/living/brandish_origin_test
	SET_BASE_PIXEL(-16, -8)

/datum/unit_test/brandish_mob_origin/Run()
	var/mob/living/brandish_origin_test/actor = allocate(/mob/living/brandish_origin_test, run_loc_floor_bottom_left)
	TEST_ASSERT_EQUAL(actor.pixel_x, 0, "Sprite centring is removed from world X")
	TEST_ASSERT_EQUAL(actor.pixel_y, 0, "Sprite centring is removed from world Y")
	TEST_ASSERT_EQUAL(actor.pixel_w, -16, "Sprite centring remains in screen X")
	TEST_ASSERT_EQUAL(actor.pixel_z, -8, "Sprite centring remains in screen Y")
	actor.add_offsets("test_world_offset", 7, 8, animate = FALSE)
	TEST_ASSERT_EQUAL(actor.pixel_x, 7, "Runtime placement remains in world X")
	TEST_ASSERT_EQUAL(actor.pixel_w, -16, "Runtime placement preserves the screen origin")
	actor.remove_offsets("test_world_offset", animate = FALSE)
	TEST_ASSERT_EQUAL(actor.pixel_x, 0, "Removing placement restores world X without restoring the old origin")
