/datum/unit_test/brandish_lying_float_offsets/Run()
	var/mob/living/brandish_origin_test/actor = allocate(/mob/living/brandish_origin_test, run_loc_floor_bottom_left)
	actor.rotate_on_lying = TRUE
	actor.add_offsets(BRANDISH_MODE_WORLD, 7, 9, FALSE)
	actor.set_body_position(LYING_DOWN)
	TEST_ASSERT_EQUAL(actor.pixel_y, 9, "Lying does not change world placement")
	TEST_ASSERT_EQUAL(actor.has_offset(LYING_DOWN_TRAIT, PIXEL_Z_OFFSET), PIXEL_Y_OFFSET_LYING, "Lying is a screen height source")
	ADD_TRAIT(actor, TRAIT_MOVE_FLOATING, "unit_float")
	actor.add_offsets("height", z_add = 4, animate = FALSE)
	REMOVE_TRAIT(actor, TRAIT_MOVE_FLOATING, "unit_float")
	sleep(12)
	TEST_ASSERT_EQUAL(actor.pixel_x, 7, "Stopping float preserves world X")
	TEST_ASSERT_EQUAL(actor.pixel_y, 9, "Stopping float preserves world Y")
	TEST_ASSERT_EQUAL(actor.pixel_z, -10, "Stopping float restores origin plus lying and seat height")
	actor.set_body_position(STANDING_UP)
	sleep(4)
	TEST_ASSERT_EQUAL(actor.pixel_z, -4, "Standing removes only the lying height")
	actor.do_attack_animation(get_step(actor, EAST), no_effect = TRUE)
	sleep(4)
	TEST_ASSERT_EQUAL(actor.pixel_x, 7, "An attack returns to its world X placement")
	TEST_ASSERT_EQUAL(actor.pixel_y, 9, "An attack returns to its world Y placement")
	TEST_ASSERT_EQUAL(actor.pixel_z, -4, "An attack preserves composed screen height")

