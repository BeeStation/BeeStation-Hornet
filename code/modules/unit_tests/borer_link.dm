/// One host outline survives until the last living borer leaves; loose borers get their own.
/datum/unit_test/borer_link_targets

/datum/unit_test/borer_link_targets/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/simple_animal/borer/first = allocate(/mob/living/simple_animal/borer)
	var/mob/living/simple_animal/borer/second = allocate(/mob/living/simple_animal/borer)
	TEST_ASSERT_EQUAL(first.link_outline.target, first, "A loose borer has no outline.")
	var/obj/item/organ/borer_cyst/head_cyst = allocate(/obj/item/organ/borer_cyst)
	var/obj/item/organ/borer_cyst/chest_cyst = allocate(/obj/item/organ/borer_cyst)
	head_cyst.configure(first, BODY_ZONE_HEAD)
	chest_cyst.configure(second, BODY_ZONE_CHEST)
	TEST_ASSERT(head_cyst.Insert(host), "Head infestation failed.")
	TEST_ASSERT(chest_cyst.Insert(host), "Chest infestation failed.")
	var/datum/atom_hud/alternate_appearance/basic/cortical_link/outline = first.link_outline
	TEST_ASSERT_EQUAL(outline.target, host, "Infestation did not move the outline to the host.")
	TEST_ASSERT_EQUAL(second.link_outline, outline, "Sharing a host created duplicate outlines.")
	TEST_ASSERT_EQUAL(length(outline.borers), 2, "The outline did not track both borers.")
	first.leave_host()
	TEST_ASSERT(!QDELETED(outline), "The first departure removed the remaining borer's host outline.")
	TEST_ASSERT_EQUAL(first.link_outline.target, first, "Leaving did not restore the loose borer's outline.")
	TEST_ASSERT_EQUAL(length(outline.borers), 1, "The departing borer remained a source of the host outline.")
	second.death()
	TEST_ASSERT(QDELETED(outline), "The last living borer's death left the host highlighted.")
	TEST_ASSERT_NULL(second.link_outline, "A dead borer retained an outline.")
	TEST_ASSERT(!host.alternate_appearances?["cortical_link"], "The abandoned host retained its link HUD.")

/// Clothing/held overlays update immediately; direction, transform and direct edits also refresh.
/datum/unit_test/borer_link_appearance

/datum/unit_test/borer_link_appearance/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/simple_animal/borer/borer = allocate(/mob/living/simple_animal/borer)
	var/obj/item/organ/borer_cyst/cyst = allocate(/obj/item/organ/borer_cyst)
	cyst.configure(borer, BODY_ZONE_HEAD)
	TEST_ASSERT(cyst.Insert(host), "Infestation failed.")
	var/datum/atom_hud/alternate_appearance/basic/cortical_link/outline = borer.link_outline
	var/image/original_image = outline.image
	TEST_ASSERT_EQUAL(outline.image.loc, host, "The outline is not anchored to the host for native glide movement.")
	TEST_ASSERT_EQUAL(outline.image.plane, PIPECRAWL_IMAGES_PLANE, "The outline is not visible above lighting and alongside vent overlays.")
	TEST_ASSERT_EQUAL(outline.image.blend_mode, BLEND_OVERLAY, "The outline has an unexpected blend mode.")
	var/mutable_appearance/extra_overlay = mutable_appearance('icons/mob/borer.dmi', "borer", layer = ABOVE_MOB_LAYER)
	var/old_overlay_count = length(outline.image.overlays)
	host.add_overlay(extra_overlay)
	TEST_ASSERT_EQUAL(length(outline.image.overlays), old_overlay_count + 1, "Adding an overlay did not update the outline immediately.")
	host.cut_overlay(extra_overlay)
	TEST_ASSERT_EQUAL(length(outline.image.overlays), old_overlay_count, "Removing an overlay left a stale outline.")
	var/previous_appearance = outline.image.appearance
	var/obj/item/clothing/head/helmet/helmet = allocate(/obj/item/clothing/head/helmet)
	TEST_ASSERT(host.equip_to_slot_if_possible(helmet, ITEM_SLOT_HEAD), "Could not equip the test helmet.")
	TEST_ASSERT(previous_appearance != outline.image.appearance, "Equipping clothing did not change the outline's shape.")
	TEST_ASSERT_EQUAL(outline.last_appearance, host.appearance, "The outline did not capture the completed clothing update.")
	previous_appearance = outline.image.appearance
	TEST_ASSERT(host.dropItemToGround(helmet), "Could not remove the test helmet.")
	TEST_ASSERT(previous_appearance != outline.image.appearance, "Removing clothing left the helmet's outline behind.")
	host.setDir(EAST)
	host.transform = matrix().Turn(90)
	host.pixel_x = 7
	host.pixel_y = -3
	// The Life fallback also catches direct edits which emit no appearance signal.
	borer.update_cortical_link()
	TEST_ASSERT_EQUAL(outline.image.dir, EAST, "The outline did not follow the host's direction.")
	TEST_ASSERT_EQUAL("[outline.image.transform]", "[host.transform]", "The outline lost the host's transform.")
	TEST_ASSERT_EQUAL(outline.image.pixel_x, 0, "The outline duplicated its anchor's horizontal offset.")
	TEST_ASSERT_EQUAL(outline.image.pixel_y, 0, "The outline duplicated its anchor's vertical offset.")
	TEST_ASSERT_EQUAL(outline.image, original_image, "Appearance refresh replaced the visible image in clients' HUDs.")
	TEST_ASSERT_EQUAL(outline.image.appearance_flags & KEEP_TOGETHER, KEEP_TOGETHER, "The outline no longer groups the host and its clothing together.")
	TEST_ASSERT_EQUAL(length(outline.image.filters), 3, "Appearance refresh lost the silhouette/outline/transparency filters.")
	var/list/registered_images = host.active_hud_list[outline.appearance_key]
	TEST_ASSERT_EQUAL(registered_images[1], original_image, "Appearance refresh changed the registered HUD image.")
	var/turf/destination = get_step(host, EAST)
	var/obj/structure/closet/closet = allocate(/obj/structure/closet)
	host.forceMove(closet)
	closet.forceMove(destination)
	TEST_ASSERT_EQUAL(outline.image.loc, host, "A container move detached the outline from the host.")
	host.death()
	TEST_ASSERT_NULL(borer.link_outline, "A dead host retained its outline.")

/// Grab offsets come from the anchored mob; copying them into the image applies them twice.
/datum/unit_test/borer_link_drag_offsets

/datum/unit_test/borer_link_drag_offsets/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/puller = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/simple_animal/borer/borer = allocate(/mob/living/simple_animal/borer)
	var/obj/item/organ/borer_cyst/cyst = allocate(/obj/item/organ/borer_cyst)
	cyst.configure(borer, BODY_ZONE_HEAD)
	TEST_ASSERT(cyst.Insert(host), "Infestation failed.")
	var/datum/atom_hud/alternate_appearance/basic/cortical_link/outline = borer.link_outline
	for(var/direction in GLOB.cardinals)
		puller.forceMove(get_step(host, direction))
		puller.set_pull_offsets(host, animate = FALSE)
		TEST_ASSERT(host.pixel_x || host.pixel_y, "The test grab did not displace the host.")
		borer.update_cortical_link()
		TEST_ASSERT_EQUAL(outline.image.loc, host, "Dragging detached the outline from its moving anchor.")
		TEST_ASSERT_EQUAL(outline.image.pixel_x, 0, "Dragging applied the horizontal grab offset twice.")
		TEST_ASSERT_EQUAL(outline.image.pixel_y, 0, "Dragging applied the vertical grab offset twice.")
		host.remove_offsets(GRABBING_TRAIT, animate = FALSE)
		borer.update_cortical_link()
		TEST_ASSERT_EQUAL(outline.image.pixel_x, 0, "Releasing the grab left a horizontal outline offset.")
		TEST_ASSERT_EQUAL(outline.image.pixel_y, 0, "Releasing the grab left a vertical outline offset.")

/// The controlled human sees the link, and the displaced human never acquires it.
/datum/unit_test/borer_link_possession

/datum/unit_test/borer_link_possession/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/bystander = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/simple_animal/borer/borer = allocate(/mob/living/simple_animal/borer)
	var/mob/living/simple_animal/borer/other_borer = allocate(/mob/living/simple_animal/borer)
	var/obj/item/organ/borer_cyst/cyst = allocate(/obj/item/organ/borer_cyst)
	host.mind_initialize()
	borer.mind_initialize()
	TEST_ASSERT(!borer.link_outline.mobShouldSee(borer), "The borer can see its own loose-body outline.")
	cyst.configure(borer, BODY_ZONE_HEAD)
	TEST_ASSERT(cyst.Insert(host), "Infestation failed.")
	var/datum/atom_hud/alternate_appearance/basic/cortical_link/outline = other_borer.link_outline
	borer.update_cortical_link_sight()
	TEST_ASSERT(!borer.link_outline.mobShouldSee(borer), "The borer can see its own host's outline.")
	TEST_ASSERT(outline.mobShouldSee(borer), "The borer cannot see the link.")
	TEST_ASSERT(!outline.mobShouldSee(host), "The host can see the link before possession.")
	TEST_ASSERT(!outline.mobShouldSee(bystander), "An uninfested bystander can see the link.")
	TEST_ASSERT(borer.transfer_host_control(), "Possession failed.")
	TEST_ASSERT(!borer.link_outline.mobShouldSee(host), "The controlling borer can see its own host's outline.")
	TEST_ASSERT(outline.mobShouldSee(host), "The borer lost link sight during possession.")
	TEST_ASSERT(!outline.mobShouldSee(borer.host_backseat), "The displaced human inherited link sight.")
	TEST_ASSERT(!outline.mobShouldSee(borer), "The vacated borer body retained link sight.")
	TEST_ASSERT(outline.hud_users_all_z_levels[host], "The controlling borer was not subscribed to the HUD.")
	TEST_ASSERT(!outline.hud_users_all_z_levels[borer], "The vacated borer body remained subscribed to the HUD.")
	host.update_cortical_link_sight()
	host.update_cortical_link_sight()
	TEST_ASSERT_EQUAL(outline.hud_users_all_z_levels[host], 1, "Repeated updates accumulated HUD subscriptions.")
	TEST_ASSERT(borer.release_host_control(), "Control release failed.")
	TEST_ASSERT(!outline.mobShouldSee(host), "The human retained link sight after release.")
	TEST_ASSERT(!outline.hud_users_all_z_levels[host], "The human retained a link HUD subscription after release.")
	TEST_ASSERT(outline.hud_users_all_z_levels[borer], "The borer did not recover its link HUD subscription.")
